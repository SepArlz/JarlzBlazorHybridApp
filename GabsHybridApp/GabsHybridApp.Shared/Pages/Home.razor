@page "/"
@using GabsHybridApp.Shared.Models
@using GabsHybridApp.Shared.Services
@inject IFormFactor FormFactor
@inject NavigationManager NavManager

<PageTitle>Home - GabsBlazorHybridApp (.NET 10)</PageTitle>

<style>
    .wallet-action-card {
        border: 1px solid var(--mud-palette-lines-default) !important;
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        position: relative;
        overflow: hidden;
        height: 100%;
        cursor: pointer;
    }
    .wallet-action-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--mud-elevation-6) !important;
        border-color: var(--mud-palette-primary) !important;
    }
    .wallet-action-card:active {
        transform: translateY(-1px);
    }

    .wallet-card-title {
        line-height: 1.35;
        font-weight: 600;
    }

    /* Dark Mode Hero Gradient Effects */
    .dark-theme .wallet-action-card,
    .mud-theme-dark .wallet-action-card {
        position: relative;
        overflow: hidden;
    }

    .dark-theme .wallet-action-card::before,
    .mud-theme-dark .wallet-action-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        z-index: 1;
    }

    /* 1. Products & Orders - Blue Hero Gradient */
    .dark-theme .wallet-card-primary,
    .mud-theme-dark .wallet-card-primary {
        background: radial-gradient(circle at 15% 15%, rgba(37, 99, 235, 0.22) 0%, transparent 65%),
                    linear-gradient(145deg, #1e293b 0%, #0f172a 100%) !important;
        border: 1px solid rgba(59, 130, 246, 0.35) !important;
        box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.6), 0 0 15px rgba(37, 99, 235, 0.12) !important;
    }
    .dark-theme .wallet-card-primary::before,
    .mud-theme-dark .wallet-card-primary::before {
        background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 50%, #818cf8 100%);
    }

    /* 2. Device Features - Cyan / Sky Hero Gradient */
    .dark-theme .wallet-card-info,
    .mud-theme-dark .wallet-card-info {
        background: radial-gradient(circle at 15% 15%, rgba(6, 182, 212, 0.22) 0%, transparent 65%),
                    linear-gradient(145deg, #1e293b 0%, #0f172a 100%) !important;
        border: 1px solid rgba(6, 182, 212, 0.35) !important;
        box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.6), 0 0 15px rgba(6, 182, 212, 0.12) !important;
    }
    .dark-theme .wallet-card-info::before,
    .mud-theme-dark .wallet-card-info::before {
        background: linear-gradient(90deg, #06b6d4 0%, #38bdf8 50%, #67e8f9 100%);
    }

    /* 3. Component Showcase - Amber / Gold Hero Gradient */
    .dark-theme .wallet-card-warning,
    .mud-theme-dark .wallet-card-warning {
        background: radial-gradient(circle at 15% 15%, rgba(245, 158, 11, 0.22) 0%, transparent 65%),
                    linear-gradient(145deg, #1e293b 0%, #0f172a 100%) !important;
        border: 1px solid rgba(245, 158, 11, 0.35) !important;
        box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.6), 0 0 15px rgba(245, 158, 11, 0.12) !important;
    }
    .dark-theme .wallet-card-warning::before,
    .mud-theme-dark .wallet-card-warning::before {
        background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 50%, #fcd34d 100%);
    }

    /* 4. Backup & Maintenance - Emerald / Green Hero Gradient */
    .dark-theme .wallet-card-success,
    .mud-theme-dark .wallet-card-success {
        background: radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.22) 0%, transparent 65%),
                    linear-gradient(145deg, #1e293b 0%, #0f172a 100%) !important;
        border: 1px solid rgba(16, 185, 129, 0.35) !important;
        box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.6), 0 0 15px rgba(16, 185, 129, 0.12) !important;
    }
    .dark-theme .wallet-card-success::before,
    .mud-theme-dark .wallet-card-success::before {
        background: linear-gradient(90deg, #10b981 0%, #34d399 50%, #6ee7b7 100%);
    }

    /* Luminous Avatar Glow in Dark Mode */
    .dark-theme .wallet-card-primary .mud-avatar,
    .mud-theme-dark .wallet-card-primary .mud-avatar {
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45) !important;
    }
    .dark-theme .wallet-card-info .mud-avatar,
    .mud-theme-dark .wallet-card-info .mud-avatar {
        box-shadow: 0 4px 14px rgba(6, 182, 212, 0.45) !important;
    }
    .dark-theme .wallet-card-warning .mud-avatar,
    .mud-theme-dark .wallet-card-warning .mud-avatar {
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.45) !important;
    }
    .dark-theme .wallet-card-success .mud-avatar,
    .mud-theme-dark .wallet-card-success .mud-avatar {
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.45) !important;
    }

    .home-hero-banner {
        position: relative;
        overflow: hidden;
        border-radius: 16px !important;
        padding: 2.5rem 2rem;
        margin-bottom: 2rem;
        transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-badge {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: white;
        font-weight: 500;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .code-box {
        background-color: var(--mud-palette-background-grey);
        border-radius: 6px;
        padding: 12px;
        font-family: 'Consolas', 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        border: 1px solid var(--mud-palette-lines-inputs);
        overflow-x: auto;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 pb-12">
    <!-- Command Center Hero Banner -->
    <div class="home-hero-banner primary-hero-paper">
        <div class="hero-ambient-glow"></div>
        <div class="hero-text-scrim"></div>

        <div class="d-flex flex-column gap-3" style="position: relative; z-index: 10;">
            <div class="d-flex flex-wrap gap-2 mb-1">
                <span class="glass-badge">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" /> .NET 10.0 LTS
                </span>
                <span class="glass-badge">
                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" /> C# 14
                </span>
                <span class="glass-badge">
                    <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" /> MudBlazor v9
                </span>
                <span class="glass-badge">
                    <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Small" /> @FormFactor.GetFormFactor() / @FormFactor.GetPlatform()
                </span>
            </div>

            <MudText Typo="Typo.h3" Class="font-weight-bold" Style="font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.2;">
                Modern .NET 10 Hybrid Enterprise Template
            </MudText>

            <MudText Typo="Typo.subtitle1" Style="opacity: 0.9; max-width: 760px; font-weight: 300;">
                High-performance unified architecture powering Web, Android, iOS, and Windows Desktop with reactive SignalR synchronization, offline-first SQLite, database-agnostic backup & restore, and dark hero aesthetics.
            </MudText>
        </div>
    </div>

    <!-- Hero Action Cards (Wallet Style Navigation) -->
    <MudGrid Class="mb-6">
        <!-- 1. Products & Orders -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="wallet-action-card wallet-card-primary pa-4 rounded-lg" Elevation="2" @onclick='() => NavManager.NavigateTo("/orders")'>
                <div class="d-flex align-center gap-3 mb-3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="wallet-card-title">Product Orders</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">CRUD & POS Flow</MudText>
                    </div>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Manage multi-line orders, dynamic calculations, real-time statuses, and print-ready invoices.
                </MudText>
                <div class="d-flex align-center gap-1 text-primary">
                    <MudText Typo="Typo.caption" Class="font-weight-bold">View Orders</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </div>
            </MudPaper>
        </MudItem>

        <!-- 2. Device Features -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="wallet-action-card wallet-card-info pa-4 rounded-lg" Elevation="2" @onclick='() => NavManager.NavigateTo("/device-features")'>
                <div class="d-flex align-center gap-3 mb-3">
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Sensors" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="wallet-card-title">Device Sensors</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Hardware Integration</MudText>
                    </div>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Access geolocation, camera, flashlight, vibration, and connectivity seamlessly on Web & MAUI.
                </MudText>
                <div class="d-flex align-center gap-1 text-info">
                    <MudText Typo="Typo.caption" Class="font-weight-bold">Test Hardware</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </div>
            </MudPaper>
        </MudItem>

        <!-- 3. Component Showcase -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="wallet-action-card wallet-card-warning pa-4 rounded-lg" Elevation="2" @onclick='() => NavManager.NavigateTo("/componentsdemo")'>
                <div class="d-flex align-center gap-3 mb-3">
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Widgets" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="wallet-card-title">Showcase</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">UI Demo Gallery</MudText>
                    </div>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Explore MudBlazor charts, OpenStreetMap leaflet, AI Markdown exports, and drawer tools.
                </MudText>
                <div class="d-flex align-center gap-1 text-warning">
                    <MudText Typo="Typo.caption" Class="font-weight-bold">Open Demos</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </div>
            </MudPaper>
        </MudItem>

        <!-- 4. Backup & Maintenance -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="wallet-action-card wallet-card-success pa-4 rounded-lg" Elevation="2" @onclick='() => NavManager.NavigateTo("/backup-restore")'>
                <div class="d-flex align-center gap-3 mb-3">
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.SettingsBackupRestore" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="wallet-card-title">Data Backup</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Disaster Recovery</MudText>
                    </div>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    ZIP archive streaming, SHA256 integrity check, adaptive schema introspection, and full wipe-restore.
                </MudText>
                <div class="d-flex align-center gap-1 text-success">
                    <MudText Typo="Typo.caption" Class="font-weight-bold">Manage Backups</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Interactive Architecture & Performance Explorer -->
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Outlined="true" Class="pa-2">
                <MudCardContent>
                    <div class="d-flex align-center gap-2 mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold">Architecture Explorer</MudText>
                    </div>

                    <MudTabs Elevation="0" Rounded="true" Centered="false" Color="Color.Primary">
                        <!-- Tab 1: .NET 10 Core & C# 14 -->
                        <MudTabPanel Text="Core & C# 14" Icon="@Icons.Material.Outlined.Terminal">
                            <div class="pt-4">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Long-Term Support (LTS) & Language Refinements</MudText>
                                <MudText Typo="Typo.body2" Class="mb-4">
                                    .NET 10 is the LTS release supported through 2028. Coupled with C# 14, it introduces field-backed properties (`field` keyword) and zero-allocation stack allocation optimizations.
                                </MudText>

                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                                    Adaptive schema migration handles legacy backup JSON archives seamlessly across breaking model shifts without requiring database downgrades.
                                </MudAlert>

                                <MudText Typo="Typo.body2" Class="font-weight-bold mb-1">C# 14 Field-Backed Properties syntax:</MudText>
                                <pre class="code-box"><code>public string CustomerName
{
    get => field;
    set => field = value?.Trim() ?? throw new ArgumentNullException();
}</code></pre>
                            </div>
                        </MudTabPanel>

                        <!-- Tab 2: Blazor HybridWebView & Interop -->
                        <MudTabPanel Text="Hybrid Interop" Icon="@Icons.Material.Outlined.Phonelink">
                            <div class="pt-4">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Host-Agnostic Device Services</MudText>
                                <MudText Typo="Typo.body2" Class="mb-4">
                                    Unified abstraction contracts allow Blazor components to operate indistinguishably between Browser and MAUI runtimes.
                                </MudText>

                                <MudGrid Class="mb-2">
                                    <MudItem xs="12" sm="6">
                                        <div class="d-flex align-start gap-2 mb-3">
                                            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Secondary" Size="Size.Small" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-bold">Two-Way JS Interop</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Invoke native APIs from JavaScript or vice-versa with seamless fallback to browser HTML5 APIs.</MudText>
                                            </div>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <div class="d-flex align-start gap-2 mb-3">
                                            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Secondary" Size="Size.Small" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-bold">Silent Delta-Sync</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">SignalR backpressure coordinator dispatches instant entity updates without reload lag.</MudText>
                                            </div>
                                        </div>
                                    </MudItem>
                                </MudGrid>
                            </div>
                        </MudTabPanel>

                        <!-- Tab 3: Security & Storage -->
                        <MudTabPanel Text="Security & DR" Icon="@Icons.Material.Outlined.Security">
                            <div class="pt-4">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Disaster Recovery & Offline Storage</MudText>
                                <MudText Typo="Typo.body2" Class="mb-3">
                                    SQLite with optional SQLCipher encryption on edge devices paired with server SQL Server / PostgreSQL. Full data backup exports can be executed and inspected with cryptographic verification.
                                </MudText>
                            </div>
                        </MudTabPanel>
                    </MudTabs>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <!-- Sandbox Simulation Widget -->
            <MudCard Outlined="true" Style="height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.DashboardCustomize" Color="Color.Secondary" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Compiler Sandbox</MudText>
                        </div>
                        <MudText Typo="Typo.caption">Interactive JIT & GC optimization visualizer</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="flex-grow: 1;" Class="d-flex flex-column justify-space-between gap-4">
                    <div>
                        <MudSelect T="string" Label="Select Benchmark Workload" @bind-Value="_selectedBenchmark" Class="mb-4" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Loop Unrolling")" />
                            <MudSelectItem Value="@("Interface Devirtualization")" />
                            <MudSelectItem Value="@("Memory Allocations (GC)")" />
                        </MudSelect>

                        @if (_isSimulating)
                        {
                            <div class="d-flex flex-column align-center justify-center py-6 gap-2">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Analyzing JIT optimizations...</MudText>
                            </div>
                        }
                        else if (_simulationFinished)
                        {
                            <div class="d-flex flex-column gap-3">
                                <div>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">.NET 8 (LTS)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Error">@_net8Time</MudText>
                                    </div>
                                    <MudProgressLinear Color="Color.Error" Value="@_net8Percent" Class="my-1" Size="Size.Medium" />
                                </div>

                                <div>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">.NET 9</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Warning">@_net9Time</MudText>
                                    </div>
                                    <MudProgressLinear Color="Color.Warning" Value="@_net9Percent" Class="my-1" Size="Size.Medium" />
                                </div>

                                <div>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold">.NET 10 (LTS)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Success">@_net10Time</MudText>
                                    </div>
                                    <MudProgressLinear Color="Color.Success" Value="@_net10Percent" Class="my-1" Size="Size.Medium" />
                                </div>

                                <MudText Typo="Typo.caption" Class="mt-2 text-justify" Style="display: block; font-style: italic;">
                                    @_benchmarkExplanation
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center py-8 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.PlayCircleFilled" Size="Size.Large" Color="Color.Primary" Style="opacity: 0.5; font-size: 3rem;" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Select a workload and click execute to simulate JIT runtime optimizations.</MudText>
                            </div>
                        }
                    </div>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunBenchmarkSimulation" Disabled="@_isSimulating" FullWidth="true">
                        @(_simulationFinished ? "Re-Run Simulation" : "Execute Workload")
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string _selectedBenchmark = "Loop Unrolling";
    private bool _isSimulating = false;
    private bool _simulationFinished = false;

    private string _net8Time = "";
    private string _net9Time = "";
    private string _net10Time = "";

    private int _net8Percent = 100;
    private int _net9Percent = 100;
    private int _net10Percent = 100;

    private string _benchmarkExplanation = "";

    private async Task RunBenchmarkSimulation()
    {
        _isSimulating = true;
        _simulationFinished = false;
        StateHasChanged();

        await Task.Delay(800);

        if (_selectedBenchmark == "Loop Unrolling")
        {
            _net8Time = "124ms";
            _net9Time = "82ms";
            _net10Time = "31ms (4.0x faster)";

            _net8Percent = 100;
            _net9Percent = 66;
            _net10Percent = 25;

            _benchmarkExplanation = "In .NET 10, the JIT compiler implements advanced loop unrolling strategies and vectorization heuristics. It expands short, fixed loops into linear instructions to eliminate branch-prediction overhead.";
        }
        else if (_selectedBenchmark == "Interface Devirtualization")
        {
            _net8Time = "215ms";
            _net9Time = "143ms";
            _net10Time = "54ms (3.9x faster)";

            _net8Percent = 100;
            _net9Percent = 66;
            _net10Percent = 25;

            _benchmarkExplanation = "Dynamic devirtualization in the .NET 10 JIT automatically resolves interface method calls to direct method invocations, enabling aggressive inlining.";
        }
        else
        {
            _net8Time = "4.2 KB (18 allocs)";
            _net9Time = "1.8 KB (8 allocs)";
            _net10Time = "0 B (0 allocations!)";

            _net8Percent = 100;
            _net9Percent = 43;
            _net10Percent = 0;

            _benchmarkExplanation = "Memory allocation tracking in .NET 10 benefits from aggressive stack allocation analysis, generating zero GC pressure for local scopes.";
        }

        _isSimulating = false;
        _simulationFinished = true;
        StateHasChanged();
    }
}
