@using GabsHybridApp.Shared.Models
@using GabsHybridApp.Shared.Services
@using MudBlazor
@inject UserService UserService
@inject ISnackbar Snackbar

<MudDialog TitleClass="pa-0">
    <TitleContent>
        <MudAppBar Elevation="4" Fixed="false">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="Cancel" Edge="Edge.Start" Class="d-inline-flex d-sm-none mr-1" aria-label="back" />
            <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-2 d-none d-sm-inline-flex" />
            @* Mobile Short Title (xs screen) *@
            <MudText Typo="Typo.h6" Color="Color.Inherit" Class="d-block d-sm-none text-truncate">
                Reset: @User.Username
            </MudText>
            @* Desktop / Tablet Full Title (sm+ screen) *@
            <MudText Typo="Typo.h6" Color="Color.Inherit" Class="d-none d-sm-block">
                Reset Password: @User.Username
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="Cancel" Class="d-none d-sm-inline-flex" aria-label="close" />
        </MudAppBar>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
            Resetting password for user account <b>@User.Username</b>. Admin force reset overrides current password requirement.
        </MudAlert>

        <MudTextField T="string" @bind-Value="_newPassword" Label="New Password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Class="mb-4" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock" />
        <MudTextField T="string" @bind-Value="_confirmPassword" Label="Confirm New Password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Class="mb-4" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockReset" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Key" OnClick="Submit">Reset Password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public UserAccount User { get; set; } = default!;

    private string _newPassword = "";
    private string _confirmPassword = "";

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add("Please enter a new password.", Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Warning);
            return;
        }

        bool success = UserService.ChangePassword(User.Username!, password: "", newPassword: _newPassword, forceChange: true);
        if (success)
        {
            Snackbar.Add($"Password for '{User.Username}' has been successfully reset!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Failed to reset password. Please verify the user exists.", Severity.Error);
        }
    }
}
