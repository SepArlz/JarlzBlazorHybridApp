@page "/weather"

<PageTitle>Weather Telemetry - Jarlz MotoHub</PageTitle>

@* DESIGN LANGUAGE: Page Hero Header — Operational title & icon badge *@
<MudPaper Elevation="0" Class="pa-4 mb-4 rounded-lg bg-transparent">
    <div class="d-flex align-center gap-3">
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
            <MudIcon Icon="@Icons.Material.Filled.WbSunny" Size="Size.Large" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h5" Color="Color.Primary"><b>Weather Telemetry</b></MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Environmental metrics and operational temperature telemetry for field technicians
            </MudText>
        </div>
    </div>
</MudPaper>

@* DESIGN LANGUAGE: Responsive Table Container *@
<MudPaper Elevation="0" Class="pa-0 pa-sm-4 mud-elevation-sm-3 bg-transparent bg-sm-surface rounded-lg">
    @if (forecasts == null)
    {
        <div class="d-flex justify-center align-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.body2" Class="ml-3 mud-text-secondary">Loading telemetry data...</MudText>
        </div>
    }
    else
    {
        <MudTable Items="forecasts" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Temp (C)</MudTh>
                <MudTh>Temp (F)</MudTh>
                <MudTh>Summary</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@context.Date.ToShortDateString()</MudTd>
                <MudTd DataLabel="Temp (C)">
                    <MudChip T="string" Size="Size.Small" Color="@(context.TemperatureC > 25 ? Color.Warning : (context.TemperatureC < 10 ? Color.Info : Color.Success))" Variant="Variant.Outlined">
                        @context.TemperatureC°C
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Temp (F)">@context.TemperatureF°F</MudTd>
                <MudTd DataLabel="Summary">
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Summary</MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate a loading indicator
        await Task.Delay(500);

        var startDate = DateOnly.FromDateTime(DateTime.Now);
        var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching" };
        forecasts = Enumerable.Range(1, 5).Select(index => new WeatherForecast
        {
            Date = startDate.AddDays(index),
            TemperatureC = Random.Shared.Next(-20, 55),
            Summary = summaries[Random.Shared.Next(summaries.Length)]
        }).ToArray();
    }

    private class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
