@inherits BlazorStateComponent
@using BlazorState
@using GabsHybridApp.Shared.States

@if(!IsWebOrDesktop)
{
    <style>
        .scroll-hidden {
            overflow: auto;
            -ms-overflow-style: none;
            scrollbar-width: none;
            /* NEW: keep the last items above the home indicator & bottom bar */
            padding-bottom: calc(env(safe-area-inset-bottom, 0px) + var(--bottom-bar-h, 56px) + 16px);
        }

            .scroll-hidden::-webkit-scrollbar {
                display: none; /* Chrome, Safari, Opera */
            }
    </style>
}

<style>
    /* ==========================================================================
       💚 Neon Console Navigation Sidebar Styling
       ========================================================================== */
    .neon-nav-menu .mud-nav-link {
        border-radius: 6px;
        margin: 2px 0;
        padding: 8px 12px;
        color: var(--mud-palette-text-secondary) !important;
        font-size: 0.875rem;
        font-weight: 400;
        transition: all 0.15s ease-in-out;
    }

    .neon-nav-menu .mud-nav-link .mud-icon-root {
        color: var(--mud-palette-text-secondary) !important;
        font-size: 1.15rem;
        transition: color 0.15s ease-in-out;
    }

    .neon-nav-menu .mud-nav-link:hover {
        background-color: @(IsDarkMode ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 0, 0, 0.04)") !important;
        color: var(--mud-palette-text-primary) !important;
    }

    .neon-nav-menu .mud-nav-link:hover .mud-icon-root {
        color: var(--mud-palette-text-primary) !important;
    }

    .neon-nav-menu .mud-nav-link.active {
        background-color: @(IsDarkMode ? "rgba(0, 229, 153, 0.10)" : "rgba(0, 184, 117, 0.10)") !important;
        color: var(--mud-palette-primary) !important;
        font-weight: 500 !important;
        border-left: 3px solid var(--mud-palette-primary);
    }

    .neon-nav-menu .mud-nav-link.active .mud-icon-root {
        color: var(--mud-palette-primary) !important;
    }

    .neon-nav-section-title {
        font-size: 0.72rem !important;
        font-weight: 600 !important;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--mud-palette-text-secondary) !important;
        opacity: 0.75;
        padding: 12px 14px 4px 14px;
        margin: 0;
    }

    .neon-nav-divider {
        border-color: var(--mud-palette-lines-default) !important;
        margin: 8px 0;
    }
</style>

<MudNavMenu Class="pa-2 neon-nav-menu" Margin="Margin.Dense" Color="Color.Inherit">
    <MudText Typo="Typo.caption" Class="neon-nav-section-title">Platform</MudText>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.GridView">Home</MudNavLink>
    <MudNavLink Href="orders" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ReceiptLong">Orders</MudNavLink>
    <MudNavLink Href="products" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Inventory2">Products</MudNavLink>
    <MudNavLink Href="device-features" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Sensors">Device Features</MudNavLink>
    <MudNavLink Href="backup-restore" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.History">Backup &amp; Restore</MudNavLink>
    <MudNavLink Href="account/users" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ManageAccounts">Manage Users</MudNavLink>

    <MudDivider Class="neon-nav-divider" />
    <MudText Typo="Typo.caption" Class="neon-nav-section-title">Developer &amp; Tools</MudText>
    <MudNavLink Href="components-demo" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Widgets">Components Demo</MudNavLink>
    <MudNavLink Href="weather" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.CloudQueue">Weather</MudNavLink>
    <MudNavLink Href="counter" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.PlusOne">Counter (@currentCount)</MudNavLink>
    <MudNavLink Href="auth" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Shield">Auth</MudNavLink>

    <MudDivider Class="neon-nav-divider" />
    <MudText Typo="Typo.caption" Class="neon-nav-section-title">Resources</MudText>
    <MudNavLink Href="https://mudblazor.com" Icon="@Icons.Custom.Brands.MudBlazor" Target="_blank">MudBlazor</MudNavLink>
    <MudNavLink Href="https://dotnet.microsoft.com/en-us/apps/aspnet/web-apps/blazor" Icon="@Icons.Custom.Brands.MicrosoftVisualStudio" Target="_blank">Blazor</MudNavLink>
    <MudNavLink Href="https://dotnet.microsoft.com/en-us/apps/aspnet" Icon="@Icons.Custom.Brands.Microsoft" Target="_blank">ASP.NET</MudNavLink>

    <MudNavGroup Title="About" Icon="@Icons.Material.Outlined.Info" HideExpandIcon="true">
        <MudNavLink Href="https://github.com/hubert17" Icon="@Icons.Material.Outlined.Code">Github</MudNavLink>
        <MudNavLink Href="https://bernardgabon.com" Icon="@Icons.Material.Outlined.Language">BernardGabon.com</MudNavLink>
    </MudNavGroup>
    <MudDivider Class="neon-nav-divider" />

    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <MudText Typo="Typo.caption" Class="neon-nav-section-title">Support</MudText>
        <MudNavGroup Title="Help" Icon="@Icons.Material.Outlined.HelpOutline" HideExpandIcon="true">
            <MudNavLink Href="https://mudblazor.com/docs/overview">Documentation</MudNavLink>
            <MudNavLink Href="https://mudblazor.com/getting-started/installation">Quick-Start Guide</MudNavLink>
        </MudNavGroup>
        <MudNavLink Href="https://github.com/hubert17/EdwillJSystem" Icon="@Icons.Custom.Brands.GitHub" Target="_blank">EdwillJSystem</MudNavLink>
    </MudHidden>
</MudNavMenu>

@code {
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public bool IsWebOrDesktop { get; set; }

    CounterState CounterState => GetState<CounterState>();
    private int currentCount => CounterState.Count;
}

