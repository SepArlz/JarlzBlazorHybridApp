@inherits LayoutComponentBase
@using GabsHybridApp.Shared.Components
@using GabsHybridApp.Shared.Layout

@implements IAsyncDisposable

@inject IFormFactor FormFactor
@inject IHostCapabilities Caps
@inject ILocalStorageService localStorage
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject IDialogService DialogService
@inject IAppThemeService ThemeService

<AntiforgeryToken />

<MyMudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" />
<MyMudProviders />

<CascadingValue Value="_isDarkMode" Name="IsDarkMode">
<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="IsWebOrDesktop() ? DrawerClipMode.Always : DrawerClipMode.Never"
               Variant="@DrawerVariant.Responsive"
               Elevation="0"
               Style="border-right: 1px solid var(--mud-palette-lines-default);"
               >
        <NavMenu IsDarkMode="_isDarkMode" IsWebOrDesktop="IsWebOrDesktop()" />
    </MudDrawer>

    <MudMainContent id="main-content-container" Class="mainlayout-with-bottom-bar-padding">
            <MudContainer Class="@(IsWebOrDesktop() ? "mt-6 mb-6" : "")">
                @Body
            </MudContainer>
    </MudMainContent>

    @if (IsWebOrDesktop())
    {
        <MudAppBar id="top-app-bar" Elevation="0" Style="border-bottom: 1px solid var(--mud-palette-lines-default);">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudIcon Icon="@Icons.Custom.Brands.MudBlazor" Size="Size.Medium" Color="Color.Primary" />
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="DrawerToggle" />
            </MudHidden>
            <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold" Style="letter-spacing: -0.02em;">Jarlz MotoHub</MudText>

            <MudSpacer />

            @* Support Links Menu *@
            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
                <MudMenu EndIcon="@Icons.Material.Outlined.KeyboardArrowDown"
                            Color="Color.Inherit"
                            Label="Support"
                            Dense="true"
                            AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudText Typo="Typo.body2" Class="px-4 py-2"><b>Community</b></MudText>
                    <MudText Typo="Typo.body2" Class="px-4 py-2"><b>Resources</b></MudText>
                    <MudMenuItem Href="https://mudblazor.com/docs/overview" Target="_blank">MudBlazor Documentation</MudMenuItem>
                    <MudMenuItem Href="https://mudblazor.com/getting-started/installation" Target="_blank">Quick-Start Guide</MudMenuItem>
                </MudMenu>
            </MudHidden>

            @* 🔔 Notification Panel (handles SignalR & user data internally) *@
            <NotificationPanel IncludeSample="true" NotificationHubUrl="@(StorageConstants.AppWebUrl + "/notificationhub")" />

            <MudHidden Breakpoint="Breakpoint.SmAndUp" Invert>
                @* 💻 GitHub Link *@
                <MudTooltip Text="Github">
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                                   Color="Color.Inherit"
                                   Href="https://github.com/hubert17/GabsBlazorHybridApp"
                                   Target="_blank" />
                </MudTooltip>
            </MudHidden>

            @* 👤 User Menu *@
            <AuthorizeView Context="authState">
                <MudMenu AnchorOrigin="Origin.TopLeft" Dense Class="mt-1 ml-4" >
                    <ActivatorContent Context="userMenuContext">
                        <MudAvatar Size="Size.Medium" Style="cursor: pointer;" @onclick="userMenuContext.ToggleAsync">
                            <MudImage Src="https://avatars.githubusercontent.com/u/7923889?v=4" />
                        </MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudListItem T="string" Text="My Account" Icon="@Icons.Material.Outlined.Person" Href="/account/changepassword" />
                        <MudListItem T="string" Text="About App" Icon="@Icons.Material.Outlined.Info" OnClick="OpenAboutAppDialog" />
                        <MudListItem T="string" Text="Logout" Icon="@Icons.Material.Outlined.Logout" OnClick='() => NavManager.NavigateToAfterAuth("/account/logout", Caps.RequiresFullReloadAfterAuth)' />
                        <MudDivider />
                    </ChildContent>
                </MudMenu>
            </AuthorizeView>

        </MudAppBar>
    }
    else
    {
        <MudAppBar Fixed Dense Color="Color.Transparent" Class="pt-2" Elevation="0">
            <MudSpacer />
            <NotificationPanel IncludeSample="true" NotificationHubUrl="" />
            <AuthorizeView Context="authState">
                <MudMenu AnchorOrigin="Origin.TopLeft" Dense>
                    <ActivatorContent Context="userMenuMobileContext">
                        <MudAvatar Size="Size.Medium" Elevation="2" Style="cursor: pointer;" @onclick="userMenuMobileContext.ToggleAsync">
                            <MudImage Src="https://avatars.githubusercontent.com/u/7923889?v=4" />
                        </MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudListItem T="string" Text="My Account" Icon="@Icons.Material.Outlined.Person" Href="/account/changepassword" />
                        <MudListItem T="string" Text="About App" Icon="@Icons.Material.Outlined.Info" OnClick="OpenAboutAppDialog" />
                        <MudListItem T="string" Text="Logout" Icon="@Icons.Material.Outlined.Logout" OnClick='() => NavManager.NavigateToAfterAuth("/account/logout", Caps.RequiresFullReloadAfterAuth)' />
                        <MudDivider />
                    </ChildContent>
                </MudMenu>
            </AuthorizeView>
        </MudAppBar>
        <MudAppBar id="bottom-app-bar" Bottom Elevation="2" Dense="false" Class="mainlayout-bottom-appbar d-flex justify-center align-center pa-0">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Class="mud-bottom-nav-item no-ripple">
                <div class="d-flex flex-column align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Outlined.Dashboard" />
                    <span class="mud-typography-caption my-n1">Home</span>
                </div>
            </MudNavLink>

            <MudNavLink Href="/device-features" Match="NavLinkMatch.Prefix" Class="mud-bottom-nav-item">
                <div class="d-flex flex-column align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Outlined.Sensors" />
                    <span class="mud-typography-caption my-n1">Device</span>
                </div>
            </MudNavLink>

            @* Placeholder for the FAB to keep the spacing right *@
            <div class="mainlayout-fab-dock" aria-hidden="true"></div>

            <MudNavLink Href="/products" Class="mud-bottom-nav-item">
                <div class="d-flex flex-column align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" />
                    <span class="mud-typography-caption my-n1">Products</span>
                </div>
            </MudNavLink>

            <MudNavLink Class="mud-bottom-nav-item" OnClick="DrawerToggle">
                <div class="d-flex flex-column align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Outlined.Menu" />
                    <span class="mud-typography-caption my-n1">Menu</span>
                </div>
            </MudNavLink>
        </MudAppBar>

        <MudFab id="main-fab"
                StartIcon="@Icons.Material.Outlined.QrCodeScanner"
                Color="Color.Primary"
                Size="Size.Large"
                OnClick="@OnFabClick"
                Class="mainlayout-fab-position mainlayout-fab-sync" />
    }


</MudLayout>
</CascadingValue>

@* Global Error UI *@
<div id="blazor-error-ui" class="@(IsWebOrDesktop() ? "blazor-error-ui--web" : "blazor-error-ui--mobile")">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MyMudThemeProvider? _themeProvider;

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;
    private bool IsWebOrDesktop() => FormFactor.GetFormFactor() == "Web" || FormFactor.GetPlatform().Contains("WinUI", StringComparison.OrdinalIgnoreCase);

    private IJSObjectReference? _mod;
    private IJSObjectReference? _handle;

    protected override void OnInitialized()
    {
        _isDarkMode = StorageConstants.IsDarkMode;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_themeProvider is not null)
            {
                _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
                StorageConstants.IsDarkMode = _isDarkMode;
                await ThemeService.SetThemeAsync(_isDarkMode);
                await _themeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
                StateHasChanged();
            }

            await SyncDocumentThemeClass(_isDarkMode);

            if (!IsWebOrDesktop())
            {
                _mod = await JS.InvokeAsync<IJSObjectReference>("import", "/js/scroll-handler.js");
                _handle = await _mod.InvokeAsync<IJSObjectReference>(
                    "registerScrollHandler",
                    "",                 // window scroll (Hybrid)
                    "bottom-app-bar",   // bottom bar
                    "main-fab",         // FAB
                    "top-app-bar",      // <-- now exists
                    "main-content-container"
                );
            }
        }
    }

    private async Task OnSystemPreferenceChanged(bool isDark)
    {
        _isDarkMode = isDark;
        StorageConstants.IsDarkMode = isDark;
        await ThemeService.SetThemeAsync(isDark);
        await SyncDocumentThemeClass(isDark);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncDocumentThemeClass(bool isDark)
    {
        try
        {
            await JS.InvokeVoidAsync("gabsTheme.setDocumentTheme", isDark);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (!IsWebOrDesktop())
        {
            try { if (_handle is not null) await _handle.InvokeVoidAsync("dispose"); }
            catch { }
            if (_mod is not null) await _mod.DisposeAsync();
        }
    }

    void OnFabClick()
    {
        // TODO: your action here
    }

    private async Task OpenAboutAppDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<AboutAppDialog>("About Application", options);
    }
}
