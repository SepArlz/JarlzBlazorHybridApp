<CascadingValue Value=false Name="UsePopoverProvider">
    <MudThemeProvider @bind-IsDarkMode="@IsDarkMode" Theme="MyTheme"></MudThemeProvider>
</CascadingValue>

@if (IsDarkMode)
{
    <style>
        /* ==========================================================================
           🌙 Dark Mode Dialog AppBar Gradients
           Injected dynamically whenever Dark Mode is active.
           Targeting ONLY MudAppBar inside MudDialog (.mud-dialog .mud-appbar)
           ========================================================================== */

        /* 🚨 Error Dialog AppBars */
        .mud-dialog .mud-appbar.mud-theme-error,
        .mud-dialog .mud-appbar.mud-appbar-error,
        .mud-dialog .mud-appbar[class*="error"],
        .mud-dialog-title .mud-appbar.mud-theme-error,
        .mud-dialog-title .mud-appbar[class*="error"] {
            background: linear-gradient(135deg, #881337 0%, #be123c 45%, #e11d48 100%) !important;
            border-bottom: 1px solid rgba(251, 113, 133, 0.3) !important;
            box-shadow: 0 4px 20px rgba(225, 29, 72, 0.3) !important;
        }

        /* 🔷 Primary Dialog AppBars */
        .mud-dialog .mud-appbar.mud-theme-primary,
        .mud-dialog .mud-appbar.mud-appbar-primary,
        .mud-dialog .mud-appbar[class*="primary"],
        .mud-dialog-title .mud-appbar.mud-theme-primary,
        .mud-dialog-title .mud-appbar[class*="primary"] {
            background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 50%, #3b82f6 100%) !important;
            border-bottom: 1px solid rgba(96, 165, 250, 0.3) !important;
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3) !important;
        }

        /* 💜 Secondary Dialog AppBars */
        .mud-dialog .mud-appbar.mud-theme-secondary,
        .mud-dialog .mud-appbar.mud-appbar-secondary,
        .mud-dialog .mud-appbar[class*="secondary"],
        .mud-dialog-title .mud-appbar.mud-theme-secondary,
        .mud-dialog-title .mud-appbar[class*="secondary"] {
            background: linear-gradient(135deg, #312e81 0%, #4338ca 50%, #6366f1 100%) !important;
            border-bottom: 1px solid rgba(165, 180, 252, 0.3) !important;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3) !important;
        }

        /* ℹ️ Info Dialog AppBars */
        .mud-dialog .mud-appbar.mud-theme-info,
        .mud-dialog .mud-appbar.mud-appbar-info,
        .mud-dialog .mud-appbar[class*="info"],
        .mud-dialog-title .mud-appbar.mud-theme-info,
        .mud-dialog-title .mud-appbar[class*="info"] {
            background: linear-gradient(135deg, #0c4a6e 0%, #0284c7 50%, #38bdf8 100%) !important;
            border-bottom: 1px solid rgba(56, 189, 248, 0.3) !important;
            box-shadow: 0 4px 20px rgba(2, 132, 199, 0.3) !important;
        }

        /* 🌲 Success Dialog AppBars */
        .mud-dialog .mud-appbar.mud-theme-success,
        .mud-dialog .mud-appbar.mud-appbar-success,
        .mud-dialog .mud-appbar[class*="success"],
        .mud-dialog-title .mud-appbar.mud-theme-success,
        .mud-dialog-title .mud-appbar[class*="success"] {
            background: linear-gradient(135deg, #064e3b 0%, #059669 50%, #10b981 100%) !important;
            border-bottom: 1px solid rgba(52, 211, 153, 0.3) !important;
            box-shadow: 0 4px 20px rgba(5, 150, 105, 0.3) !important;
        }

        /* ⚠️ Warning Dialog AppBars */
        .mud-dialog .mud-appbar.mud-theme-warning,
        .mud-dialog .mud-appbar.mud-appbar-warning,
        .mud-dialog .mud-appbar[class*="warning"],
        .mud-dialog-title .mud-appbar.mud-theme-warning,
        .mud-dialog-title .mud-appbar[class*="warning"] {
            background: linear-gradient(135deg, #78350f 0%, #d97706 50%, #f59e0b 100%) !important;
            border-bottom: 1px solid rgba(251, 191, 36, 0.3) !important;
            box-shadow: 0 4px 20px rgba(217, 119, 6, 0.3) !important;
        }

        /* 🌑 Default / Neutral Dialog AppBars */
        .mud-dialog .mud-appbar:not([class*="primary"]):not([class*="error"]):not([class*="success"]):not([class*="warning"]):not([class*="info"]):not([class*="secondary"]),
        .mud-dialog-title .mud-appbar:not([class*="primary"]):not([class*="error"]):not([class*="success"]):not([class*="warning"]):not([class*="info"]):not([class*="secondary"]) {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5) !important;
        }
    </style>
}

