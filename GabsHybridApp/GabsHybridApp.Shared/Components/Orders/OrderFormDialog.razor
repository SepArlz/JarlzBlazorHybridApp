@using GabsHybridApp.Shared.Models
@using GabsHybridApp.Shared.Services
@using GabsHybridApp.Shared.Data
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IOrderService OrderService
@inject IDbContextFactory<HybridAppDbContext> DbFactory
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudAppBar Color="Color.Primary" Elevation="0" Dense="true" Class="px-3">
            <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Class="mr-2" />
            <MudText Typo="Typo.h6">@(IsEditMode ? $"Edit Order #{Order.OrderNumber}" : "New Product Order")</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Inherit" OnClick="Cancel" Size="Size.Small" />
        </MudAppBar>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formIsValid" Class="mt-1">
            <MudGrid>
                @* DESIGN LANGUAGE: Highlighted Customer & Destination Tile Banner *@
                <MudItem xs="12" Class="mt-3 mb-2">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between flex-wrap gap-2" Style="background: rgba(0, 229, 153, 0.08); border-left: 5px solid var(--mud-palette-primary);">
                        <div class="d-flex align-center gap-3">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.PersonPinCircle" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary" Style="letter-spacing: -0.02em; line-height: 1.2;">
                                    Customer &amp; Destination
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Recipient contact info, fulfillment mode &amp; branch store assignment
                                </MudText>
                            </div>
                        </div>
                        <MudChip T="string" Color="@(_isFaceToFace ? Color.Info : Color.Primary)" Variant="Variant.Filled" Size="Size.Small" Icon="@(_isFaceToFace ? Icons.Material.Outlined.Storefront : Icons.Material.Outlined.LocalShipping)">
                            @(_isFaceToFace ? "In-Store / Face-to-Face" : "Delivery Order")
                        </MudChip>
                    </MudPaper>
                </MudItem>

                @* Fulfillment Choice: Delivery vs Face-to-Face in Shop Branch *@
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold mb-1 d-block">Fulfillment &amp; Transaction Method</MudText>
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudButton Variant="@(!_isFaceToFace ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.LocalShipping"
                                   Size="Size.Small"
                                   OnClick="@(() => OnFulfillmentModeChanged(false))">
                            Door-to-Door Delivery
                        </MudButton>
                        <MudButton Variant="@(_isFaceToFace ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Outlined.Storefront"
                                   Size="Size.Small"
                                   OnClick="@(() => OnFulfillmentModeChanged(true))">
                            Branch / Face-to-Face Transaction
                        </MudButton>
                    </div>
                </MudItem>

                @* Customer Details Inputs *@
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Order.CustomerName" Label="Customer Full Name" Required="true" RequiredError="Customer name is required" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Order.CustomerPhone" Label="Contact Phone" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Order.CustomerEmail" Label="Email Address" InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Order.Status" Label="Order Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @if (_isFaceToFace)
                        {
                            @* Face-to-Face Branch Transaction Status Choices *@
                            <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                            <MudSelectItem Value="@("Finished")">Finished</MudSelectItem>
                        }
                        else
                        {
                            @* Delivery Orders Full Status Choices *@
                            <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                            <MudSelectItem Value="@("Processing")">Processing</MudSelectItem>
                            <MudSelectItem Value="@("Shipped")">Shipped</MudSelectItem>
                            <MudSelectItem Value="@("Delivered")">Delivered</MudSelectItem>
                            <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Order.PaymentMethod" Label="Payment Method" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("CashOnDelivery")">Cash on Delivery (COD)</MudSelectItem>
                        <MudSelectItem Value="@("Cash")">Cash (Over-the-Counter)</MudSelectItem>
                        <MudSelectItem Value="@("CreditCard")">Credit / Debit Card</MudSelectItem>
                        <MudSelectItem Value="@("GCash")">GCash / E-Wallet</MudSelectItem>
                        <MudSelectItem Value="@("BankTransfer")">Bank Transfer</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Order.PaymentStatus" Label="Payment Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                        <MudSelectItem Value="@("Paid")">Paid</MudSelectItem>
                        <MudSelectItem Value="@("Refunded")">Refunded</MudSelectItem>
                        <MudSelectItem Value="@("Failed")">Failed</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Address / Branch Input *@
                @if (_isFaceToFace)
                {
                    <MudItem xs="12">
                        <MudSelect T="string"
                                   Label="Shop Branch Location (Face-to-Face)"
                                   Value="_selectedBranch"
                                   ValueChanged="OnBranchSelected"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   HelperText="Order transaction conducted over the counter inside this shop branch. Shipping fee is waived.">
                            @foreach (var branch in _branchOptions)
                            {
                                <MudSelectItem Value="@branch">@branch</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Order.ShippingAddress"
                                      Label="Delivery Shipping Address"
                                      Lines="2"
                                      Required="true"
                                      RequiredError="Shipping address is required for delivery"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                @* Order Line Items *@
                <MudItem xs="12" Class="mt-3">
                    <div class="d-flex justify-space-between align-center mb-1">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="font-weight-bold">Order Items</MudText>
                        <MudButton StartIcon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="AddItemRow">
                            Add Line Item
                        </MudButton>
                    </div>
                    <MudDivider Class="mb-3" />
                </MudItem>

                @if (Order.Items.Count == 0)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">
                            Please add at least one product item to this order.
                        </MudAlert>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudTable Items="Order.Items" Dense="true" Hover="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh>Product</MudTh>
                                <MudTh Style="width: 120px;">Unit Price</MudTh>
                                <MudTh Style="width: 90px;">Qty</MudTh>
                                <MudTh Style="width: 100px;">Discount</MudTh>
                                <MudTh Style="width: 120px;" Class="text-right">Line Total</MudTh>
                                <MudTh Style="width: 50px;"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Product">
                                    <MudSelect T="int?" Value="@context.ProductId" ValueChanged="@(id => OnProductSelected(context, id))" Dense="true" Margin="Margin.Dense" Variant="Variant.Text">
                                        @foreach (var p in _availableProducts)
                                        {
                                            <MudSelectItem T="int?" Value="@p.Id">@p.Name (@p.UnitPrice.ToString("C"))</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd DataLabel="Unit Price">
                                    <MudNumericField T="decimal" Value="@context.UnitPrice" ValueChanged="@(v => { context.UnitPrice = v; Recalculate(); })" Format="N2" Margin="Margin.Dense" Variant="Variant.Text" />
                                </MudTd>
                                <MudTd DataLabel="Qty">
                                    <MudNumericField T="int" Value="@context.Quantity" ValueChanged="@(v => { context.Quantity = v; Recalculate(); })" Min="1" Margin="Margin.Dense" Variant="Variant.Text" />
                                </MudTd>
                                <MudTd DataLabel="Discount">
                                    <MudNumericField T="decimal" Value="@context.Discount" ValueChanged="@(v => { context.Discount = v; Recalculate(); })" Min="0" Format="N2" Margin="Margin.Dense" Variant="Variant.Text" />
                                </MudTd>
                                <MudTd DataLabel="Line Total" Class="text-right">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.TotalPrice.ToString("C")</MudText>
                                </MudTd>
                                <MudTd Class="text-center">
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveItemRow(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudItem>
                }

                @* Financial Calculation Summary *@
                <MudItem xs="12" sm="6" Class="mt-3">
                    <MudTextField @bind-Value="Order.Notes" Label="Order Notes / Memo" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="mt-3">
                    <MudPaper Outlined="true" Class="pa-3 rounded">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Sub-Total:</MudText>
                            <MudText Typo="Typo.body2">@Order.SubTotal.ToString("C")</MudText>
                        </div>
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Order Discount:</MudText>
                            <MudNumericField T="decimal" Value="@Order.DiscountAmount" ValueChanged="@(v => { Order.DiscountAmount = v; Recalculate(); })" Format="N2" Min="0" Margin="Margin.Dense" Variant="Variant.Text" Style="max-width: 110px; text-align: right;" />
                        </div>
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Shipping Fee:</MudText>
                            @if (_isFaceToFace)
                            {
                                <span class="mud-text-secondary" style="font-size: 0.85rem;">Waived ($0.00)</span>
                            }
                            else
                            {
                                <MudNumericField T="decimal" Value="@Order.ShippingFee" ValueChanged="@(v => { Order.ShippingFee = v; Recalculate(); })" Format="N2" Min="0" Margin="Margin.Dense" Variant="Variant.Text" Style="max-width: 110px; text-align: right;" />
                            }
                        </div>
                        <MudDivider Class="my-2" />
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Grand Total:</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">@Order.TotalAmount.ToString("C")</MudText>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton OnClick="SaveOrder" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!_formIsValid || Order.Items.Count == 0 || _isSaving)">
            @(_isSaving ? "Saving..." : "Save Order")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Order Order { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }

    private MudForm? _form;
    private bool _formIsValid;
    private bool _isSaving;
    private List<Product> _availableProducts = new();

    private bool _isFaceToFace = false;
    private string _selectedBranch = "Main Shop - Downtown Hub";
    private readonly string[] _branchOptions = new[]
    {
        "Main Shop - Downtown Hub",
        "North Service Center Branch",
        "South Moto Parts Branch",
        "Over-the-Counter Pickup"
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _availableProducts = await db.Products.AsNoTracking().OrderBy(p => p.Name).ToListAsync();

        if (Order.IsBranchPickup)
        {
            _isFaceToFace = true;
            var cleanBranch = Order.ShippingAddress?
                .Replace("Branch:", "")
                .Replace("(Face-to-Face)", "")
                .Trim();
            if (!string.IsNullOrWhiteSpace(cleanBranch))
            {
                _selectedBranch = cleanBranch;
            }
        }

        if (Order.Items.Count == 0 && _availableProducts.Count > 0)
        {
            AddItemRow();
        }
        else
        {
            Recalculate();
        }
    }

    private void OnFulfillmentModeChanged(bool isFaceToFace)
    {
        _isFaceToFace = isFaceToFace;
        if (_isFaceToFace)
        {
            Order.ShippingFee = 0m;
            Order.ShippingAddress = $"Branch: {_selectedBranch} (Face-to-Face)";
            if (Order.PaymentMethod == "CashOnDelivery")
            {
                Order.PaymentMethod = "Cash";
            }
            if (Order.Status != "Pending" && Order.Status != "Finished")
            {
                Order.Status = "Finished";
            }
        }
        else
        {
            if (Order.ShippingAddress?.Contains("Branch:", StringComparison.OrdinalIgnoreCase) == true)
            {
                Order.ShippingAddress = string.Empty;
            }
            if (Order.Status == "Finished")
            {
                Order.Status = "Delivered";
            }
        }
        Recalculate();
    }

    private void OnBranchSelected(string branch)
    {
        _selectedBranch = branch;
        if (_isFaceToFace)
        {
            Order.ShippingAddress = $"Branch: {_selectedBranch} (Face-to-Face)";
        }
    }

    private void AddItemRow()
    {
        var first = _availableProducts.FirstOrDefault();
        Order.Items.Add(new OrderItem
        {
            Id = Guid.CreateVersion7(),
            ProductId = first?.Id,
            ProductName = first?.Name ?? "Custom Item",
            ProductUnit = first?.Unit ?? "unit",
            UnitPrice = first?.UnitPrice ?? 0m,
            Quantity = 1,
            Discount = 0m,
            TotalPrice = first?.UnitPrice ?? 0m
        });
        Recalculate();
    }

    private void RemoveItemRow(OrderItem item)
    {
        Order.Items.Remove(item);
        Recalculate();
    }

    private void OnProductSelected(OrderItem item, int? productId)
    {
        item.ProductId = productId;
        var p = _availableProducts.FirstOrDefault(x => x.Id == productId);
        if (p != null)
        {
            item.ProductName = p.Name ?? "Product";
            item.ProductUnit = p.Unit;
            item.UnitPrice = p.UnitPrice;
        }
        Recalculate();
    }

    private void Recalculate()
    {
        foreach (var item in Order.Items)
        {
            item.TotalPrice = Math.Max(0, (item.UnitPrice * item.Quantity) - item.Discount);
        }

        Order.SubTotal = Order.Items.Sum(i => i.TotalPrice);
        Order.TotalAmount = Math.Max(0, Order.SubTotal - Order.DiscountAmount + Order.TaxAmount + (_isFaceToFace ? 0m : Order.ShippingFee));
    }

    private async Task SaveOrder()
    {
        if (_form != null)
        {
            await _form.ValidateAsync();
            if (!_formIsValid || Order.Items.Count == 0) return;
        }

        if (_isFaceToFace)
        {
            Order.ShippingFee = 0m;
            Order.ShippingAddress = $"Branch: {_selectedBranch} (Face-to-Face)";
        }

        _isSaving = true;
        try
        {
            Recalculate();

            if (!IsEditMode && string.IsNullOrWhiteSpace(Order.OrderNumber))
            {
                await OrderService.CreateOrderAsync(Order);
                Snackbar.Add($"Order #{Order.OrderNumber} created successfully!", Severity.Success);
            }
            else
            {
                await OrderService.UpdateOrderAsync(Order);
                Snackbar.Add($"Order #{Order.OrderNumber} updated successfully!", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(Order));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save order: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
